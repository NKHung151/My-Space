# Sao chép file này thành application.properties (bị .gitignore chặn).
# Secret đọc từ biến môi trường dạng ${TÊN_BIẾN:giá-trị-mặc-định} -> không cần ghi secret thật vào file.
spring.application.name=myspace

# Datasource — tạo DB rỗng trước: CREATE DATABASE myspace CHARACTER SET utf8mb4;
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/myspace}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD}

# Schema do Flyway quản lý (db/migration/V*.sql); Hibernate chỉ kiểm tra entity khớp với DB
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# Flyway — chạy V1 (schema) + V2 (seed) khi khởi động lần đầu trên DB rỗng
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=false

# Elasticsearch
spring.elasticsearch.uris=http://localhost:9200

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379

# JWT — secret tối thiểu 256 bit (64 ký tự hex). Sinh bằng: openssl rand -hex 64
jwt.secret=${JWT_SECRET}
jwt.access-token.expiration=900000
jwt.refresh-token.expiration=86400000
# Cookie refresh_token chỉ gửi qua HTTPS — bật true khi deploy production
app.cookie.secure=${COOKIE_SECURE:false}

# Jackson: bỏ field null khỏi JSON response
spring.jackson.default-property-inclusion=non_null

# Mail (Gmail SMTP — dùng App Password, không dùng mật khẩu tài khoản)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_APP_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Cloudinary
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME}
cloudinary.api-key=${CLOUDINARY_API_KEY}
cloudinary.api-secret=${CLOUDINARY_API_SECRET}

# Actuator
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

# Upload limits — khớp giới hạn trong code (ảnh 10MB, video/audio 100MB).
# Request lớn hơn bị từ chối ngay (413), không đọc hết body.
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=101MB

# Origin của frontend được phép gọi API / mở WebSocket (nhiều giá trị cách nhau bởi dấu phẩy)
app.cors.allowed-origins=http://localhost:4200

# Nếu chạy sau reverse proxy (Nginx...), bật dòng dưới để rate limit dùng đúng IP thật của client
#server.forward-headers-strategy=native

# Service kiểm duyệt ảnh (nsfw-ai)
moderation.url=http://127.0.0.1:8000
moderation.api-key=${MODERATION_API_KEY:}
